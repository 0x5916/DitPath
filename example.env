# PostgreSQL
POSTGRES_USER=opencw
POSTGRES_PASSWORD=
POSTGRES_DB=opencw
DB_PORT=5432
# Host path for PostgreSQL data (set this to your external disk mount in LXC)
POSTGRES_DATA_PATH=/data/postgres

# PostgreSQL resource tuning
# New installations use the locally pinned PGTune calculator, defaulting to a web app.
# Set the RAM budget for PostgreSQL alone, leaving room for the other LXC services.
# This value also sets Docker's memory limit; 2g is an example, not the whole LXC RAM.
# Preview with make tune; see db/README.md for defaults and compatibility adjustments.
# Sizes accept Compose's byte syntax: 512mb, 2g, or a plain byte count.
POSTGRES_TUNE_MODE=pgtune
POSTGRES_MEMORY_LIMIT=2g

# Optional overrides: remove the leading # to enable a value. Comments use #, not //.
# Tuning values must be literal; $ interpolation is rejected to keep preview Docker-free.
# Modes: pgtune, opencw (previous calculator), off (image defaults).
# Existing .env files without POSTGRES_TUNE_MODE retain the opencw calculator.
# POSTGRES_TUNE_PROFILE=web
# CPUs are detected when omitted; setting a value also enforces Docker's CPU limit.
# POSTGRES_CPU_LIMIT=2
# Web defaults to 200 connections; keep this above the backend pool plus admin users.
# POSTGRES_MAX_CONNECTIONS=200
# POSTGRES_TUNE_STORAGE=ssd
# POSTGRES_TUNE_DB_SIZE=mid_ram
# make deploy/update calculate Docker /dev/shm before creation in pgtune mode.
# This DitPath policy is separate from PGTune; an explicit value wins.
# POSTGRES_SHM_SIZE=256mb
# Fallback only when no memory budget/cgroup limit is available; avoid this on LXC.
# POSTGRES_HOST_MEMORY_SHARE=50
# Legacy disable flag: 1 uses image defaults; conflicts with explicit non-off mode.
# POSTGRES_TUNE_DISABLE=0
# Extra server arguments are appended last, overriding calculated values.
# POSTGRES_TUNE_EXTRA=-c work_mem=8MB

# pgAdmin 4 admin UI
# PGADMIN_DEFAULT_EMAIL is the login for pgAdmin itself. It is an email address, NOT a
# PostgreSQL role. Set it once - pgAdmin derives its own storage paths from it.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
# Host port for the pgAdmin UI. It is published on 127.0.0.1 only; public access goes through
# the Cloudflare tunnel (see DEPLOYMENT.md) behind a Zero Trust Access policy.
PGADMIN_PORT=5050

# Backend
# JWT secret must be base64-encoded bytes (≥ 32 raw bytes recommended).
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Required: backend/internal/configs/config.go validates this on startup and exits
# if it is empty, so a blank value crash-loops the backend container.
RESEND_API_KEY=
RESEND_FROM_EMAIL=DitPath <no-reply@example.com>

# Comma-separated list of origins the browser is allowed to call the API from.
CORS_ORIGINS=http://localhost:3000,https://www.opencw.net,https://opencw.net

# Empty means auth quotas use the TCP peer. Enable only verified proxy CIDRs.
AUTH_TRUSTED_PROXY_CIDRS=

# Backend runtime tuning
READ_TIMEOUT=15s
READ_HEADER_TIMEOUT=5s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=20s

# Backend DB pool tuning
DB_MAX_OPEN_CONNS=30
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Cloudflare Tunnel (always started with the stack; leave the token empty to disable it)
CLOUDFLARED_TUNNEL_TOKEN=
CLOUDFLARED_PROTOCOL=quic

# Frontend (build-time)
# URL the *browser* uses to reach the backend API.
# For local access with the default port mappings:
PUBLIC_API_BASE=https://api.opencw.net/v1

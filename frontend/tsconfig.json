{
  "extends": "$app/tsconfig",
  "include": ["src", "test", "tests", "*"],
  "exclude": ["node_modules", "src/service-worker", "src/service-worker.ts"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    // TypeScript 6 defaults "types" to []; the app + scripts checks need Node
    // builtins (vite.config.ts imports scripts/paraglide-options.ts -> node:fs).
    "types": ["$app/types", "node"],
    "moduleResolution": "bundler"
  }
  // #lib is declared with Node subpath imports in package.json.
  // The worker has its own project extending $app/tsconfig/service-worker.
}

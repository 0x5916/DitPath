# All variables are build-time only: the site is fully static and never reads
# environment variables at runtime.

# API base URL, baked into the client bundle ($env/static/public).
PUBLIC_API_BASE=http://localhost:8080/v1

# Optional Google web client ID; match the backend GOOGLE_CLIENT_ID.
# Empty disables Google sign-in and prevents loading Google's SDK.
PUBLIC_GOOGLE_CLIENT_ID=

# Origin used for canonical URLs, hreflang alternates, Open Graph tags and
# sitemap.xml while prerendering.
# PRERENDER_ORIGIN=https://opencw.net

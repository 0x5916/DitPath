{
  "name": "morsewell-frontend",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "acceptance": "node scripts/acceptance/launch.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "paraglide:compile": "node --experimental-strip-types scripts/compile-paraglide.ts",
    "check": "svelte-kit sync && npm run paraglide:compile && svelte-check --tsconfig ./tsconfig.json && npm run check:worker",
    "check:watch": "svelte-kit sync && npm run paraglide:compile && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "check:worker": "tsc --noEmit -p src/service-worker/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audio:audit": "node scripts/audio-audit.mjs",
    "verify": "npm run messages:validate && npm run seo:validate && npm run check && npm run check:scripts && npm run test",
    "seo:validate": "node --experimental-strip-types scripts/validate-seo.ts",
    "seo:routing": "node scripts/check-seo-routing.mjs",
    "messages:validate": "node --experimental-strip-types scripts/validate-messages.ts",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.3.1",
    "@sveltejs/mcp": "0.1.31",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.5",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^3.2.2",
    "@lucide/svelte": "^1.75.0"
  }
}

{
  "name": "cw-frontend",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "paraglide:compile": "node --experimental-strip-types scripts/compile-paraglide.ts",
    "check": "svelte-kit sync && npm run paraglide:compile && svelte-check --tsconfig ./tsconfig.json && npm run check:worker",
    "check:watch": "svelte-kit sync && npm run paraglide:compile && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "check:worker": "tsc --noEmit -p src/service-worker/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run messages:validate && npm run seo:validate && npm run check && npm run check:scripts && npm run test",
    "seo:validate": "node --experimental-strip-types scripts/validate-seo.ts",
    "messages:validate": "node --experimental-strip-types scripts/validate-messages.ts",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/mcp": "0.1.26",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.27.0",
    "@lucide/svelte": "^1.56.0"
  }
}
